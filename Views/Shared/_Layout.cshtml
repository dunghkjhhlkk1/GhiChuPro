@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Ghi Chú Pro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        teal: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6', // Màu xanh lam ngọc chủ đạo
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/phosphor-icons"></script>
    <style>
        body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">
    <!-- Navbar (Fully Responsive) -->
    <header class="bg-white/90 backdrop-blur-md border-b border-teal-100 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-2">
            <!-- Brand -->
            <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-teal-500 flex items-center justify-center text-white shadow-md shadow-teal-500/20">
                        <i class="ph-note-pencil text-xl sm:text-2xl"></i>
                    </div>
                    <span class="text-lg sm:text-xl font-bold tracking-tight text-teal-950">Ghi Chú <span class="text-teal-500">Pro</span></span>
                </a>
            </div>

            <!-- User Auth & Info -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-teal-50 border border-teal-200/60 text-xs font-medium text-teal-800 max-w-[120px] sm:max-w-[200px] truncate">
                        <i class="ph-user-circle text-teal-600 text-sm sm:text-base shrink-0"></i>
                        <span class="truncate">@User.Identity?.Name</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-2.5 py-1 sm:px-3 sm:py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition-colors border border-rose-200/60 flex items-center gap-1">
                            <i class="ph-sign-out text-sm"></i>
                            <span class="hidden sm:inline">Đăng xuất</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-xs sm:text-sm font-medium text-teal-700 hover:text-teal-800">Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-white py-3 sm:py-4 text-center text-[11px] sm:text-xs text-slate-500 px-4">
        &copy; 2026 Ghi Chú Pro - Tựa Google Keep với giao diện Lam Ngọc tinh tế & Quản lý tiến độ thông minh.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
