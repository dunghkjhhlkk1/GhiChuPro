@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - Ghi Chú Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        teal: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/phosphor-icons"></script>
</head>
<body class="bg-gradient-to-br from-teal-50 via-slate-50 to-teal-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Logo & Brand Header -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-teal-500 mx-auto flex items-center justify-center text-white shadow-xl shadow-teal-500/25 mb-3">
                <i class="ph-note-pencil text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-teal-950">Ghi Chú <span class="text-teal-600">Pro</span></h1>
            <p class="text-xs text-slate-500 mt-1">Đăng nhập để quản lý ghi chú thông minh của anh</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 backdrop-blur-md rounded-3xl shadow-xl shadow-teal-900/5 border border-white/60 p-8 space-y-6">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-600">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="flex items-center gap-1.5"><i class="ph-warning-circle text-sm"></i> @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Tên tài khoản</label>
                    <div class="relative">
                        <i class="ph-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                        <input type="text" name="username" required autofocus placeholder="admin"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500 focus:bg-white focus:ring-4 focus:ring-teal-500/10 transition-all text-slate-800" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <i class="ph-lock-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                        <input type="password" name="password" required placeholder="••••••"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500 focus:bg-white focus:ring-4 focus:ring-teal-500/10 transition-all text-slate-800" />
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-slate-600">
                        <input type="checkbox" name="rememberMe" value="true" checked class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button type="submit" 
                        class="w-full py-3 px-4 bg-teal-500 hover:bg-teal-600 active:bg-teal-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-teal-500/25 transition-all flex items-center justify-center gap-2">
                    <span>Đăng nhập ngay</span>
                    <i class="ph-arrow-right font-bold text-base"></i>
                </button>
            </form>

            <div class="pt-2 text-center text-xs text-slate-400 border-t border-slate-100">
                Tài khoản khởi tạo: <span class="font-semibold text-slate-600">admin</span> | Mật khẩu: <span class="font-semibold text-slate-600">123456</span>
            </div>
        </div>
    </div>
</body>
</html>
